{% extends is_granted('ROLE_JURY') ? 'jury/base.html.twig' : (is_granted('ROLE_TEAM') ? 'team/base.html.twig' : 'public/base.html.twig') %}

{% block title %}{{ title | default('Agentrix AI Arena') }} - DOMjudge{% endblock %}

{% block extrahead %}
    {{ parent() }}
    <style>
        /* DOMjudge Native Style Harmonization for Agentrix */
        .bot-pill {
            display: inline-flex;
            align-items: center;
            gap: 0.35rem;
            padding: 0.2rem 0.5rem;
            border-radius: 4px;
            background-color: #f1f3f5;
            border: 1px solid #dee2e6;
            margin: 0.15rem;
            font-size: 0.85rem;
            color: #212529;
        }

        .bot-color-dot {
            width: 10px;
            height: 10px;
            border-radius: 50%;
            display: inline-block;
            flex-shrink: 0;
            border: 1px solid rgba(0, 0, 0, 0.2);
        }

        .summary-stat-card {
            border: 1px solid #dee2e6;
            border-radius: 6px;
            background: #fff;
            transition: box-shadow 0.15s ease, border-color 0.15s ease;
        }

        .summary-stat-card:hover {
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
            border-color: #ced4da;
        }

        .summary-stat-card .stat-value {
            font-size: 1.8rem;
            font-weight: 700;
            line-height: 1.1;
        }

        .summary-stat-card .stat-label {
            font-size: 0.75rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            color: #6c757d;
        }
    </style>
{% endblock %}
